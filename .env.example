# Copy to .env (never commit .env) and change the secrets.

# Postgres
POSTGRES_DB=monedasegura
POSTGRES_USER=monedasegura
POSTGRES_PASSWORD=change-me

# Secrets shared by the services
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SCORING_SERVICE_TOKEN=change-me

# Host ports (change only if they clash with something on your machine)
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=9094
DECISION_SERVICE_PORT=8080
SCORING_SERVICE_PORT=8000
APP_PORT=3000
KAFKA_UI_PORT=8081

# Seed (docs/data.md)
SEED_CUSTOMERS=200
SEED_MONTHS=6
SEED_RANDOM_SEED=42
USD_TO_COP=4000
